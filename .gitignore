# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Secrets / local config
.env
*.pem
.aws/

# Data & artifacts (never in git)
# data/raw and data/processed are DVC-tracked: DVC writes data/.gitignore + data/*.dvc for them.
# data/interim is daily runtime state, synced to object storage instead.
/data/interim/*
!/data/interim/.gitkeep
models/*
!models/.gitkeep
mlruns/
mlartifacts/
lightning_logs/
reports/monitoring/*
!reports/monitoring/.gitkeep

# Prefect local state
.prefect/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
