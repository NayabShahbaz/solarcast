# Copy to .env and fill in. NEVER commit .env.

# ---------------------------------------------------------------------------
# Object storage - ONE of the two blocks below is active.
# Code in src/solarcast/data/storage.py works with either; see planning/aws_migration.md
# ---------------------------------------------------------------------------

# --- Option A: DagsHub S3-compatible storage (current) ---
# Bucket name = DagsHub repo name. Access key AND secret are both your DagsHub token
# (DagsHub -> User settings -> Tokens). Exact endpoint: repo page -> Remote -> Bucket.
S3_ENDPOINT_URL=https://dagshub.com/api/v1/repo-buckets/s3/<dagshub-user>
S3_BUCKET=solarcast
AWS_ACCESS_KEY_ID=<dagshub-token>
AWS_SECRET_ACCESS_KEY=<dagshub-token>
AWS_REGION=us-east-1

# --- Option B: AWS S3 (after migration) ---
# S3_ENDPOINT_URL=
# S3_BUCKET=solarcast-data
# AWS_PROFILE=solarcast          # local machines; on EC2 leave unset and use the instance role
# AWS_REGION=ap-south-1

# Prefixes (same on both backends)
S3_RAW_PREFIX=raw/
S3_PROCESSED_PREFIX=processed/
S3_MONITORING_PREFIX=monitoring/

# ---------------------------------------------------------------------------
# MLflow (Member 2) - shared tracking server + model registry for the whole team
# ---------------------------------------------------------------------------
# --- Default: DagsHub hosted MLflow (same repo and token as DVC) ---
MLFLOW_TRACKING_URI=https://dagshub.com/<dagshub-user>/solarcast.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-user>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>

# --- Offline only: local server (docker compose --profile offline up mlflow) ---
# Runs logged here stay on your laptop and are NOT visible to the team or the API.
# MLFLOW_TRACKING_URI=http://localhost:5000
# (comment out MLFLOW_TRACKING_USERNAME / MLFLOW_TRACKING_PASSWORD above)

MLFLOW_EXPERIMENT=solarcast
MLFLOW_MODEL_NAME=solarcast-tft

# Leave PREFECT_API_URL commented to let flows start a temporary local server automatically.
# PREFECT_API_URL=http://localhost:4200/api
PREFECT_SERVER_ANALYTICS_ENABLED=false
DO_NOT_TRACK=1

# API (Member 3)
MODEL_ALIAS=production   # loads models:/solarcast-tft@production (MLflow stages are deprecated)
API_HOST=0.0.0.0
API_PORT=8000
