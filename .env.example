# Copy to .env and fill in. NEVER commit .env.

# ---------------------------------------------------------------------------
# DagsHub - data versioning (DVC), object storage and MLflow, all in one repo
# ---------------------------------------------------------------------------
# Shared repo, owned by Member 1. Everyone keeps these two lines as they are.
DAGSHUB_REPO_OWNER=NayabShahbaz
DAGSHUB_REPO=solarcast
# Your OWN DagsHub account (each member: user name + token from User settings -> Tokens).
DAGSHUB_USER=<your-dagshub-user>
DAGSHUB_TOKEN=<your-dagshub-token>

# ---------------------------------------------------------------------------
# MLflow (Member 2) - DagsHub hosted tracking server + model registry
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=https://dagshub.com/${DAGSHUB_REPO_OWNER}/${DAGSHUB_REPO}.mlflow
MLFLOW_TRACKING_USERNAME=${DAGSHUB_USER}
MLFLOW_TRACKING_PASSWORD=${DAGSHUB_TOKEN}
MLFLOW_EXPERIMENT=solarcast
MLFLOW_MODEL_NAME=solarcast-tft
# Offline only (docker compose --profile offline up mlflow): runs stay on your laptop.
# MLFLOW_TRACKING_URI=http://localhost:5000

# ---------------------------------------------------------------------------
# Prefect
# ---------------------------------------------------------------------------
# Leave PREFECT_API_URL commented to let flows start a temporary local server automatically.
# PREFECT_API_URL=http://localhost:4200/api
PREFECT_SERVER_ANALYTICS_ENABLED=false
DO_NOT_TRACK=1

# ---------------------------------------------------------------------------
# API (Member 3)
# ---------------------------------------------------------------------------
MODEL_ALIAS=production   # loads models:/solarcast-tft@production (MLflow stages are deprecated)
API_HOST=0.0.0.0
API_PORT=8000
